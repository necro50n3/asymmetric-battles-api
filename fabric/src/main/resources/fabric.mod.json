{
    "schemaVersion": 1,
    "id": "${archives_name}",
    "version": "${version}",
    "name": "${display_name}",
    "description": "${description}",
    "authors": [
        "NecroSo1"
    ],
    "contact": {
        "homepage": "https://github.com/necro50n3/asymmetric-battles-api",
        "issues": "https://github.com/necro50n3/asymmetric-battles-api/issues"
    },
    "license": "MIT License",
    "icon": "assets/asymmetricbattles/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.necro.asymmetric.battles.fabric.AsymmetricBattlesAPIFabric"
        ],
        "client": [
            "com.necro.asymmetric.battles.fabric.AsymmetricBattlesAPIFabricClient"
